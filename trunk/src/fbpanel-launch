PS4="+:\${0}:\${LINENO}: "
set -xu

error_state="${error_state:-0}"

XRDP_SESSION="${XRDP_SESSION:-NotSet}"

function select_primary_panels {
    panel_sides_pool+=("TOP")
}


function select_secondary_panels {
    if [ "${XRDP_SESSION}" == "1" ] ; then
        panel_sides_pool+=("RIGHT")
    else
        panel_sides_pool+=("LEFT")
    fi
}


function select_session_type {
    if [ "${XRDP_SESSION}" == "1" ] ; then
        session_type=REMOTE
    else
        session_type=ALL-WM
    fi
}

# #
 #
#

declare     select_session_type=NotSet
declare -a  panel_sides_pool=()

if [[ "${*}" =~ (^|[[:space:]])(--primary|-p)([[:space:]]|$) ]] ; then
    select_primary_panels
elif [[ "${*}" =~ (^|[[:space:]])(--secondary|-s)([[:space:]]|$) ]] ; then
    select_secondary_panels
else
    select_primary_panels
    select_secondary_panels
fi

for side in "${panel_sides_pool[@]}" ; do
    select_session_type
    f_profile="${USER}.$(hostname)_${session_type}_MAIN_${side}_fbPanel-6-1.conf"
    if ! pgrep --list-full fbpanel | grep --quiet "${f_profile}" ; then
        nohup fbpanel \
            --profile \
                "${USER}.$(hostname)_${session_type}_MAIN_${side}_fbPanel-6-1.conf" \
                    2>/dev/null 1>/dev/null &
    else
        error_state=1
        true : ERROR : skipping launch, as FBPanel is already running with ${f_profile}
    fi
done

true : Job done.
exit $error_state
