PS4="+:${0##*/}:\${LINENO}: "
set -eu -o pipefail
if [ "${#}" -eq 0 ] || [[ "${*}" =~ (^|[[:space:]])(-h|--help)([[:space:]]|$) ]] ; then
    echo "
Name: ${0##*/} - Pointer device on-off switcher.

Options code:
"
    grep \
        -E \
        "^[[:space:]]{0,}(--){0,1}[-\|_a-zA-Z0-9]{1,})" \
        "${0}"
    exit
fi
if [[ "${*}" =~ (^|[[:space:]])(-v|--verbose)([[:space:]]|$) ]] ; then
    set -x
    #declare -r opt_verbose="--verbose"
fi

declare -r conf_file="${HOME}/.config/script-crypt/pointer-switch.json"

# # #
# #
#

function switch_on {
    set_state 1
}

function switch_off {
    set_state 0
}

function set_state {
    # 'xfsettingsd' often only creates Device_Enabled after the device
    # has been changed once in the GUI.

    local name="${POINTER_NAME}"
    local property_path="${PROPERTY_PATH}"
    local state="${1}"
    local -A state_text=(["0"]="disabled" ["1"]="enabled")

    xfconf-query \
        --channel pointers \
        --property "/${name}/${property_path}" \
        --create \
        --type int \
        --set "${state}"

    notify-send \
        --urgency=normal \
        --app-name="${0##*/}" \
        "Pointer device switch:" \
        "Pointer '${name}' is now ${state_text[$state]}." \
            || true
}

function get_state {
    local name="${POINTER_NAME}"
    local property_path="${PROPERTY_PATH}"

    xfconf-query \
        --channel pointers \
        --property "/${name}/${property_path}" \
            || echo 1
}

function create_conf {
    local -a menu_items=()
    local    name=""
    local    selected_name=""

    if [ ! -t 0 ] ; then
        echo "ERROR:${0##*/}:${LINENO}: No terminal for device selection. Run '${0##*/} --configure' in a terminal." >&2
        notify-send \
            --urgency=critical \
            --app-name="${0##*/}" \
            "Pointer device switch:" \
            "Not configured. Run '${0##*/} --configure' in a terminal." \
                || true
        trap - EXIT
        exit 1
    fi

    while read -r name ; do
        [ -n "${name}" ] || continue
        menu_items+=( "${name}" "" )
    done < <( xfconf-query -c pointers -l | cut -d/ -f2 | sort -u )

    if [ "${#menu_items[@]}" -eq 0 ] ; then
        echo "ERROR:${0##*/}:${LINENO}: No pointer devices found in 'xfconf' channel 'pointers'." >&2
        exit 1
    fi

    selected_name="$( whiptail \
                            --title " question " \
                            --menu "Choose pointer device among ever seen:" \
                            0 0 0 \
                            "${menu_items[@]}" \
                            3>&1 1>&2 2>&3 )" \
        || {
            echo "INFO:${0##*/}:${LINENO}: Configuration has been cancelled." >&2;
            exit 0;
        }
    if [ -z "${selected_name}" ] ; then exit 0 ; fi
    mkdir -p "${conf_file%/*}"
    tmp_conf_file="$( mktemp "${conf_file}.XXXXXX" )"
    jq \
        --null-input \
        --arg name "${selected_name}" \
        '{ pointer: { name: $name, switch_option: "Properties/Device_Enabled" } }' \
            > "${tmp_conf_file}" \
                || { rm -f "${tmp_conf_file}"; exit 1; }
    mv -f "${tmp_conf_file}" "${conf_file}"
    echo "INFO:${0##*/}:${LINENO}: Configuration file '${conf_file}' has been created." >&2

}

# # #
# #
#

trap 'exit_code="${?}"
        if [ "${exit_code}" -ne 0 ] ; then
            notify-send \
                --urgency=critical \
                --app-name="${0##*/}" \
                "Pointer device switch:" \
                "Smth. failed with CLI command '\''${0##*/}'\''" \
                    || true
        fi' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 131' QUIT
trap 'exit 143' TERM

while [ ${#} -gt 0 ] ; do
    arg_name="${1%%=*}"
    #case "${1}" in
    #    --*=*|-?=*)
    #        arg_value="${1#*=}"
    #        shift
    #        set -- "${arg_name}" "${arg_value}" "$@"
    #        ;;
    #esac
    #arg_value="${2:-}"
    case "${arg_name}" in
        -s|--switch)        # Change state to opposite.
            opt_switch=true
            ;;
        -y|-1|--on)         # Switch it on.
            opt_on=true
            ;;
        -n|-0|--off)        # Switch it off.
            opt_off=true
            ;;
        -c|--configure)     # Force configuration file creation.
            opt_configure=true
            ;;
        -v|--verbose)       # Enable debug output.
            true
            ;;
        *)
            echo "ERROR:${0##*/}:${LINENO}: Got unknown argument '${arg_name}'." >&2
            exit 1
    esac
    shift
done

# # #
# #
#

if [ "${XDG_SESSION_TYPE:-}" == 'wayland' ] ; then
    # On Wayland mouse settings are internal to the compositor, see "Wayland
    # limitations" at https://www.xfce.org/about/tour420

    echo "WARNING:${0##*/}:${LINENO}: Wayland session detected. 'xfsettingsd' may not apply 'pointers' channel properties, the switch may have no effect." >&2
    notify-send \
        --urgency=normal \
        --app-name="${0##*/}" \
        "Pointer device switch:" \
        "Wayland session detected. The switch may have no effect." \
            || true
fi

if [ "${opt_configure:-}" == 'true' ] ; then
    create_conf
elif [ ! -f "${conf_file}" ] ; then
    create_conf
fi

jq . "${conf_file}" >/dev/null  # Configuration file syntax validation.

POINTER_NAME="$( jq --raw-output '.pointer.name | strings' "${conf_file}" )"
PROPERTY_PATH="$( jq --raw-output '.pointer.switch_option | strings' "${conf_file}" )"
declare -r POINTER_NAME PROPERTY_PATH
if [ -z "${POINTER_NAME}" ] ; then
    echo "ERROR:${0##*/}:${LINENO}: No string '.pointer.name' in configuration file '${conf_file}'. Run '${0##*/} --configure'." >&2
    exit 1
fi
if [ -z "${PROPERTY_PATH}" ] ; then
    echo "ERROR:${0##*/}:${LINENO}: No string '.pointer.switch_option' in configuration file '${conf_file}'. Run '${0##*/} --configure'." >&2
    exit 1
fi

if [ "${opt_switch:-}" == 'true' ] ; then
    POINTER_STATE="$( get_state )"
    set_state $(( !POINTER_STATE ))
fi
if [ "${opt_on:-}" == 'true' ] ; then
    switch_on
fi
if [ "${opt_off:-}" == 'true' ] ; then
    switch_off
fi

true : Job done.
