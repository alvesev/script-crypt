# Printout names - Intended to be default, if no other match above.
#
# MC internal shielding is applied, but do not work with '$' in
# a file name, for example, when reveals spaces and single quote
# marks. Thus, it is a trick to shield the name properly in
# every possible cases. There is
#       bash -c 'read -r s ; printf "%q\n" "$s"'
# However, it will overlap with MC partial quotation, leading to
# wrong quotation.
#
# Pay attention, how `dash` (which is behind `sh` at the moment of
# writing) implementation of `echo` is mixed with `coreutils`
# implementation of `echo`. In fact it is automatic, the full path was
# added for evidence.

=+ ! t t
p   Print current name and
        #echo "Shielded name:"
        #echo
        #/usr/bin/echo -n %d/%f | bash -c 'read -r s ; printf "%q\n" "$s"'  # Absence of double quotes in '%d/%f' is crucial in context of internal MC quotation.
        #echo
        echo "For a text copy:"
        echo
        n=\'%d/%f\'
        echo "${n}"

=+ t t
p   Print selected names
        #echo
        #echo "Shielded names:"
        #echo
        #for name in %t ; do  # Absence of double quotes in '%t' is crucial in context of internal MC quotation.
            /usr/bin/echo -n %d/"${name}" | bash -c 'read -r s ; printf "%q\n" "$s"'
        #done
        #echo
        echo "For a text copy:"
        echo
        set %t
        as_text_all=$(for name in "${@}" ; do /usr/bin/echo "'%d/${name}'" ; done)
        echo "${as_text_all}"
 
=+ t t
P   Print selected names as single line
        #echo
        #echo "Shielded names:"
        #echo
        #set %t
        #as_text_all=$(for name in "${@}" ; do /usr/bin/echo -n %d/"${name}" | bash -c 'read -r s ; printf "%q    " "$s"' ; done)
        #echo "${as_text_all}"
        #echo
        echo "For a text copy:"
        echo
        as_text_all=$(for name in "${@}" ; do /usr/bin/echo -n "'"%d/"${name}'    " ; done)
        echo "${as_text_all}"

