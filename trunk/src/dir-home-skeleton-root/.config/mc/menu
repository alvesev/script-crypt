shell_patterns=0

###
##	Notes and descriptions.
#
#
#   '+ t t'
#   '+ ! t t'
#
#       +: Starts a new menu section.
#      '!': Menu item visibility switch, upon a file or directory-or-file is
#           under cursor.
#       First 't': The menu is visible if the current panel is a directory.
#       Second 't': The menu is available (selectable) if the current panel
#                   is a directory.
##

##
#  Some universal tools section.
#

v       Edit - VIM
        CMD=/usr/bin/vim
        "$CMD" %f %t

v       Edit - Nano
        CMD=/usr/bin/nano
        "$CMD" %f %t

v       Edit - MC Edit
        CMD=/usr/bin/mcedit
        "$CMD" %f %t

+ ! t t
b       Edit - Hexedit
        CMD=hexedit
        nohup $CMD %f 1>/dev/null 2>/dev/null &

##
#  "Open with" section, specific to file extension. Will be preselected
#  in GUI-TUI.
#

+= f ^menu$ & t r
o       MC menu config - open with Vim
        nohup vim %f %t 1>/dev/null 2>/dev/null &

+= f (\.[hH][tT][mM][lL]|\.[hH][tT][mM]|\.[xX][hH][tT][mM][lL])$ & t r
o       WWW browser - open with
        if which browser-current ; then
            CMD=`type -p browser-current`
        else
            CMD=www-browser
        fi
        echo "Using '${CMD}'." >&2
        nohup "${CMD}" %f %t 1>/dev/null 2>/dev/null &

+= f (\.[jJ][sS][oO][nN]|\.[yY][aA][mM][lL]|\.[lL][iI][bB][sS][oO][nN][nN][eE][tT]|\.[jJ][sS][oO][nN][nN][eE][tT])$ & t r
o       Browser - open with
        CMD=/usr/bin/links
        nohup $CMD %f %t 1>/dev/null 2>/dev/null &

# Compressed file
+= f \.[zZ][iI][pP]$ & t r
o       Test Zip file integrity
        err_state=0
        for fName in $( for path in %f %t ; do
                            echo "${path}"
                        done | sort | uniq )
        do
            if ! zip --test "%d/${fName}" ; then
                echo "ERROR: Test failed for '${fName}'."
                err_state=1
            fi
        done
        for fName in %T ; do
            if ! zip --test "%D/${fName}" ; then
                err_state=1
                echo "ERROR: Test failed for '${fName}'."
            fi
        done
        set +x
        if test "${err_state}" -eq "0" ; then
            echo "SUCCESS: Test(s) is(are) Ok. Press 'Enter' to continue..."
        else
            echo "ERROR: Test(s) failed. Press 'Enter' to continue..."
        fi
        read -p ' ' x

# Markdown
+= f \.([mM][dD])$ & t r
o       BatCat - open with
        batcat %f %t

