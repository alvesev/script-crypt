+ t t
I       Zip or UnZip selected files (one arch. per file)
        ts=`get-timestamp`
        for i in %t
        do
            case "${i}" in
                *.zip)
                    unzip -d . "${i}"
                    ;;
                *)
                    zip -9 --recurse-paths "${i}-${ts}.zip" "${i}"
